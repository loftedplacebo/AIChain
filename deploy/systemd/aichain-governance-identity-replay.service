[Unit]
Description=Orvessian synthetic-test WorkOS revocation replay step
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aichain-governance-api
Group=aichain-governance-api
WorkingDirectory=/opt/aichain/governance-worker
ExecStart=/opt/aichain/.toolchains/node-v24.21.0-linux-x64/bin/node scripts/governance-identity-replay.cjs --apply-revocations /etc/aichain-governance/identity-replay.json
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/aichain-governance/identity-replay.json
MemoryMax=256M
CPUQuota=100%
