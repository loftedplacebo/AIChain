[Unit]
Description=Orvessian production governance API (private loopback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orvessian-prod-api
Group=orvessian-prod-api
WorkingDirectory=/opt/aichain/orvessian-production-api
EnvironmentFile=/etc/orvessian-production-api.env
EnvironmentFile=/etc/aichain/production/workos.env
ExecStart=/opt/aichain/.toolchains/node-v24.21.0-linux-x64/bin/node scripts/governance-production-api.cjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/orvessian-production-api.env
MemoryMax=512M
CPUQuota=100%
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
