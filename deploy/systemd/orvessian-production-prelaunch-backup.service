[Unit]
Description=Orvessian closed Production database backup to Backblaze B2
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/aichain/governance-pilot-db-setup/run-production-prelaunch-backup.py --apply
TimeoutStartSec=20min
NoNewPrivileges=true
ProtectHome=true
