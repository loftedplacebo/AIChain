[Unit]
Description=Orvessian daily internal Responses receipt canary
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=orvessian-chain-watch
Group=orvessian-chain-watch
WorkingDirectory=/opt/aichain/orvessian-chain-watch
EnvironmentFile=/etc/orvessian-chain-watch.env
EnvironmentFile=/etc/orvessian-internal-responses-canary.env
ExecStart=/usr/bin/python3 /opt/aichain/orvessian-chain-watch/internal-responses-canary.py
TimeoutStartSec=1900
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/orvessian-internal-responses-canary
MemoryMax=192M
CPUQuota=20%
TasksMax=32
LimitNOFILE=256
