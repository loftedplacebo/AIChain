[Unit]
Description=Orvessian hosted pilot evidence worker (Base Sepolia)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=aichain-governance-pilot-worker
Group=aichain-governance-pilot-worker
WorkingDirectory=/opt/aichain/governance-pilot-worker
EnvironmentFile=/etc/aichain-governance-pilot-worker.env
ExecStartPre=/opt/aichain/.toolchains/node-v24.21.0-linux-x64/bin/node scripts/governance-worker-recover-lock.cjs
ExecStart=/opt/aichain/.toolchains/node-v24.21.0-linux-x64/bin/node scripts/governance-worker.cjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/aichain-governance-pilot-worker
MemoryMax=512M
CPUQuota=100%
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
