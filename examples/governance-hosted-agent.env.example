# Copy to build/orvessian-agent.env and replace the reference placeholders.
ORVESSIAN_API_URL=https://api.orvessian.com
ORVESSIAN_TOKEN=replace-with-short-lived-write-only-project-key
ORVESSIAN_READ_TOKEN=replace-with-short-lived-read-only-project-key
ORVESSIAN_TENANT=replace-with-tenant-reference
ORVESSIAN_PROJECT=replace-with-project-reference
ORVESSIAN_QUEUE_PATH=C:/AIChain/build/governance-agent-queue.sqlite
