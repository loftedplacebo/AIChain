{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aichain:spec:governance-event:0.1.0-draft",
  "title": "AIChain Governance Event 0.1.0-draft",
  "description": "Bounded text/JSON governance telemetry. Contains structured fields and references/commitments only; never source prompts, conversations, documents or raw sensor payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "profile", "tenantRef", "projectRef", "environment", "eventId", "streamRef", "sequence", "eventType", "occurredAt", "receivedAt", "source"],
  "properties": {
    "schema": {"const": "aichain.governance-event"},
    "schemaVersion": {"const": "0.1.0-draft"},
    "profile": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(urn:|https://)[^\\s]+$"},
    "tenantRef": {"$ref": "#/$defs/ref"},
    "projectRef": {"$ref": "#/$defs/ref"},
    "environment": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9._-]+$"},
    "eventId": {"$ref": "#/$defs/id"},
    "streamRef": {"$ref": "#/$defs/id"},
    "runRef": {"$ref": "#/$defs/id"},
    "caseRef": {"$ref": "#/$defs/id"},
    "sequence": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$", "maxLength": 20},
    "occurredAt": {"$ref": "#/$defs/time"},
    "receivedAt": {"$ref": "#/$defs/time"},
    "eventType": {"enum": ["ai.run.completed", "ai.policy.evaluated", "ai.human.reviewed", "ai.outcome.adjudicated", "ai.runtime.config-observed", "ai.monitor.alerted"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "integrationVersion", "keyRef"],
      "properties": {
        "kind": {"enum": ["customer-sdk", "customer-gateway", "independent-monitor", "downstream-system", "human-reviewer", "provider-attestation"]},
        "integrationVersion": {"$ref": "#/$defs/ref"},
        "keyRef": {"$ref": "#/$defs/ref"},
        "signatureRef": {"$ref": "#/$defs/ref"}
      }
    },
    "agentRef": {"$ref": "#/$defs/ref"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["providerRef", "modelRef", "deploymentRef", "configVersion"],
      "properties": {
        "providerRef": {"$ref": "#/$defs/ref"},
        "modelRef": {"$ref": "#/$defs/ref"},
        "deploymentRef": {"$ref": "#/$defs/ref"},
        "configVersion": {"$ref": "#/$defs/ref"},
        "approvedConfigDigest": {"$ref": "#/$defs/digest"},
        "observedConfigDigest": {"$ref": "#/$defs/digest"},
        "observationSource": {"$ref": "#/$defs/ref"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policyRef", "version"],
      "properties": {
        "policyRef": {"$ref": "#/$defs/ref"},
        "version": {"$ref": "#/$defs/ref"},
        "decision": {"enum": ["allow", "deny", "review", "not-applicable"]},
        "ruleRefs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}
      }
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "taskClass": {"$ref": "#/$defs/ref"},
        "promptTemplateRef": {"$ref": "#/$defs/ref"},
        "inputClass": {"$ref": "#/$defs/ref"},
        "outputClass": {"$ref": "#/$defs/ref"},
        "retrievalCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "toolCalls": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/toolCall"}},
        "latencyMs": {"type": "integer", "minimum": 0, "maximum": 86400000},
        "tokenBand": {"enum": ["0-1k", "1k-2k", "2k-4k", "4k-8k", "8k-16k", "16k+", "unknown"]},
        "costBand": {"enum": ["0-0.001", "0.001-0.01", "0.01-0.1", "0.1+", "unknown"]}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "decisionCode": {"$ref": "#/$defs/ref"},
        "predictedLabel": {"$ref": "#/$defs/ref"},
        "actionCode": {"$ref": "#/$defs/ref"},
        "status": {"enum": ["completed", "blocked", "escalated", "failed", "pending"]}
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["forEventId", "label", "labelSource", "evaluatorRef"],
      "properties": {
        "forEventId": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/ref"},
        "labelSource": {"enum": ["human-adjudication", "downstream-system", "calibrated-measurement", "customer-feedback", "automated-evaluator"]},
        "evaluatorRef": {"$ref": "#/$defs/ref"},
        "rubricVersion": {"$ref": "#/$defs/ref"},
        "adjudicatedAt": {"$ref": "#/$defs/time"}
      }
    },
    "monitor": {
      "type": "object", "additionalProperties": false,
      "required": ["monitorRef", "signalCode", "severity"],
      "properties": {
        "monitorRef": {"$ref": "#/$defs/ref"},
        "signalCode": {"$ref": "#/$defs/ref"},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "expectedDigest": {"$ref": "#/$defs/digest"},
        "observedDigest": {"$ref": "#/$defs/digest"},
        "disposition": {"enum": ["open", "acknowledged", "investigating", "mitigated", "closed", "false-positive"]}
      }
    },
    "evidenceRefs": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "commitment", "availability"],
        "properties": {
          "role": {"$ref": "#/$defs/ref"},
          "commitment": {"$ref": "#/$defs/digest"},
          "availability": {"enum": ["customer-held", "customer-controlled-reference", "not-disclosed", "deleted-under-policy"]}
        }
      }
    },
    "parentEventRefs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "extensions": {
      "type": "object", "maxProperties": 16,
      "propertyNames": {"pattern": "^[a-z][a-z0-9.-]*:[a-z][a-z0-9._-]*$"},
      "additionalProperties": {"type": "object", "maxProperties": 32}
    }
  },
  "allOf": [
    {"if": {"properties": {"eventType": {"const": "ai.run.completed"}}, "required": ["eventType"]}, "then": {"required": ["runRef", "agentRef", "model", "activity", "result"]}},
    {"if": {"properties": {"eventType": {"const": "ai.policy.evaluated"}}, "required": ["eventType"]}, "then": {"required": ["runRef", "policy"]}},
    {"if": {"properties": {"eventType": {"const": "ai.human.reviewed"}}, "required": ["eventType"]}, "then": {"required": ["runRef", "agentRef", "result"]}},
    {"if": {"properties": {"eventType": {"const": "ai.outcome.adjudicated"}}, "required": ["eventType"]}, "then": {"required": ["caseRef", "outcome"]}},
    {"if": {"properties": {"eventType": {"const": "ai.runtime.config-observed"}}, "required": ["eventType"]}, "then": {"required": ["agentRef", "model"]}},
    {"if": {"properties": {"eventType": {"const": "ai.monitor.alerted"}}, "required": ["eventType"]}, "then": {"required": ["agentRef", "monitor"]}}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "ref": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "time": {"type": "string", "format": "date-time", "maxLength": 24, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "digest": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
    "toolCall": {
      "type": "object", "additionalProperties": false,
      "required": ["toolRef", "version", "resultCode"],
      "properties": {"toolRef": {"$ref": "#/$defs/ref"}, "version": {"$ref": "#/$defs/ref"}, "resultCode": {"$ref": "#/$defs/ref"}, "allowed": {"type": "boolean"}}
    }
  }
}
