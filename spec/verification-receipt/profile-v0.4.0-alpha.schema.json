{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "subjectKinds",
    "requiredEvidence",
    "requireStream",
    "requireObservation",
    "specificationDigest"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(urn:|https://)[!-~]+$",
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$",
      "maxLength": 64
    },
    "subjectKinds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*:[a-z][a-z0-9._-]*$",
        "maxLength": 160
      }
    },
    "requiredEvidence": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*:[a-z][a-z0-9._-]*$",
        "maxLength": 160
      }
    },
    "requireStream": {
      "type": "boolean"
    },
    "requireObservation": {
      "type": "boolean"
    },
    "specificationDigest": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    }
  }
}
