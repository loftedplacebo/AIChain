{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aichain.dev/spec/avr/avr-v0.1.0-draft.schema.json",
  "title": "AIChain AVR v0.1.0 draft",
  "description": "Phase 1B prototype schema. It is not a final protocol commitment.",
  "type": "object",
  "required": ["schema", "schemaVersion", "assuranceLevel", "issuer", "execution", "commitments"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "aichain.avr" },
    "schemaVersion": { "const": "0.1.0-draft" },
    "assuranceLevel": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "execution": {
      "type": "object",
      "required": ["claimedAt"],
      "additionalProperties": false,
      "properties": {
        "claimedAt": { "type": "string", "format": "date-time", "pattern": "Z$" }
      }
    },
    "commitments": {
      "type": "object",
      "required": ["configuration", "input", "model", "output", "policy", "provider"],
      "additionalProperties": false,
      "properties": {
        "configuration": { "$ref": "#/$defs/bytes32" },
        "input": { "$ref": "#/$defs/bytes32" },
        "model": { "$ref": "#/$defs/bytes32" },
        "output": { "$ref": "#/$defs/bytes32" },
        "policy": { "$ref": "#/$defs/bytes32" },
        "provider": { "$ref": "#/$defs/bytes32" }
      }
    }
  },
  "$defs": {
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
  }
}
