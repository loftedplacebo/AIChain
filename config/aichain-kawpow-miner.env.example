# AIChain GPU miner profile (copy outside the repository before use).
# No private key, wallet password, endpoint credential or pool secret belongs here.

# Separate miner fork or the pinned upstream fallback.
AICHAIN_MINER_REPOSITORY_URL=https://github.com/RavenCommunity/kawpowminer.git
AICHAIN_MINER_COMMIT=632f6ea0a5cd09e2c6443374dbe6db0a767715ba

# RTX 3060 / CUDA 12.x profile. Use 86 for compute capability 8.6.
AICHAIN_KAWPOW_COMPUTE=86
AICHAIN_MINER_BACKEND=cuda

# The adapter and node remain loopback-only on the mining host.
AICHAIN_MINER_ADAPTER_URL=http://127.0.0.1:18545
AICHAIN_NODE_RPC_URL=http://127.0.0.1:8545

# The node's explicit development flag is configured separately and is not
# enabled by this profile.
