# Closed-testnet release manifest — public, non-secret configuration only.
# Copy outside Git, replace every REPLACE_* value after the required approvals,
# then validate with scripts/validate-closed-testnet-plan.sh.
#
# This file does not start a network. It deliberately cannot hold passwords,
# private keys, RPC credentials, cloud tokens, or an allocation list.

AICHAIN_TESTNET_NAME=REPLACE_TESTNET_NAME
AICHAIN_CHAIN_ID=REPLACE_CHAIN_ID
AICHAIN_NETWORK_ID=REPLACE_NETWORK_ID
AICHAIN_GENESIS_SHA256=REPLACE_GENESIS_SHA256

# KawPoW is the current closed-testnet candidate only. It is not a mainnet
# selection, and the final consensus/economic parameters remain TBD.
AICHAIN_CONSENSUS_PROFILE=kawpow-candidate

# Comma-separated opaque operator identifiers. Use independent operators and
# regions; do not publish IP addresses in a public repository.
AICHAIN_MINER_OPERATORS=REPLACE_MINER_A,REPLACE_MINER_B,REPLACE_MINER_C
AICHAIN_VALIDATOR_OPERATORS=REPLACE_VALIDATOR_A,REPLACE_VALIDATOR_B
AICHAIN_REGIONS=REPLACE_REGION_A,REPLACE_REGION_B

# Closed-testnet exposure policy: public JSON-RPC is forbidden until a later,
# separately approved public-testnet release.
AICHAIN_PUBLIC_RPC=false
AICHAIN_RPC_BINDING=private
AICHAIN_P2P_ALLOWLIST=true
AICHAIN_MONITORING=required
AICHAIN_RESET_RUNBOOK_VERSION=REPLACE_RUNBOOK_VERSION
